# canopy-apns — every variable the relay reads, with nothing secret in it.
#
# Two uses:
#
#   * Coolify. Paste this whole file into the deployment's environment-variable
#     editor (it accepts a bulk .env paste), then fill in the five blanks. Mark
#     CANOPY_APNS_SIGNING_SECRET and CANOPY_APNS_PRIVATE_KEY as secret and as
#     build-time-hidden; neither should ever reach a build log.
#   * Locally. `cp .env.example .env` and `docker compose up`. `.env` is
#     gitignored; this file is not, which is why it holds no values.
#
# The compose file declares every variable below with an empty default, so an
# unset one arrives blank rather than as a literal placeholder — see the note
# on `${VAR:-}` in docker-compose.yml for why that distinction cost a
# deployment once.


# --- Required. The relay will not start without this. ------------------------

# HMAC secret behind every instance API key: a key is `canopy_<id>_<MAC>` and
# nothing else, which is what lets this service have no database. Generate once
# with `python -m canopy_apns secret` (or `docker compose run --rm canopy-apns
# secret`) and never again — regenerating it invalidates every key ever issued,
# which is also the break-glass revocation.
#
# Startup refuses a value that is blank, contains whitespace, matches known
# placeholder boilerplate, or is under 32 characters. A relay that will not
# boot beats one minting forgeable keys.
CANOPY_APNS_SIGNING_SECRET=


# --- Required to actually push. Absent is a supported state. ------------------
#
# All four or none. With none of them set the service still starts, /health
# reports "apns": "unconfigured", /v1/verify tells instances so, and pushes get
# a 503 that says whose problem it is — a fresh deployment waiting on its .p8
# is not a crash loop. Three out of four counts as none, deliberately: three
# cannot send anything.
#
# Where these come from: Apple Developer portal → Certificates, Identifiers &
# Profiles → Keys. Create a key with APNs enabled and download it; Apple lets
# you download it exactly once.

# Ten characters, top right of the developer portal.
CANOPY_APNS_TEAM_ID=

# The push key's own id — printed beside the key, and in the filename
# AuthKey_ABC123DEFG.p8.
CANOPY_APNS_KEY_ID=

# The app's bundle id, sent to Apple as the APNs topic. Apple rejects a push
# whose topic does not match the app the device token came from, so this is one
# value for the whole relay rather than something an instance sends.
CANOPY_APNS_BUNDLE_ID=

# The .p8 contents. A PEM is multi-line and most secret editors are not, so
# three shapes are accepted and whichever survived the paste works: the PEM
# verbatim, the PEM with literal \n where the newlines were, or base64 of the
# whole file (`base64 -w0 AuthKey_ABC123DEFG.p8`). Whether the result is a
# usable ES256 key is checked at startup, so a mis-paste is one line in the
# deploy log rather than notifications quietly not arriving.
CANOPY_APNS_PRIVATE_KEY=

# Alternative to the above: a path to a mounted .p8. Leave blank on Coolify —
# the point of the relay being stateless is that there is no volume to mount.
CANOPY_APNS_PRIVATE_KEY_FILE=


# --- Optional. The defaults are the deployed ones. ---------------------------

# Comma-separated instance ids to refuse despite a valid signature. This is
# per-instance revocation, for when rotating the signing secret would punish
# everyone. Leave empty until you need it.
CANOPY_APNS_REVOKED_INSTANCES=

# Per-instance ceiling, so one misconfigured instance cannot spend the
# operator's standing with Apple. A token bucket, counted per replica and in
# memory — with N replicas the effective ceiling is N times this. That is fine:
# the limit exists to stop a flood, not to meter a product.
CANOPY_APNS_RATE_LIMIT=120
CANOPY_APNS_RATE_BURST=30

# Self-service enrollment: instances get their own key from POST /v1/instances,
# so no self-hoster ever handles a credential. Set ENABLED=false to close the
# door entirely; instances already holding a key keep working.
#
# Because keys are free, the per-address limit is what actually caps abuse —
# anyone refused by the per-instance limit above can enrol again for a fresh
# bucket. That trade is deliberate; see the README.
CANOPY_APNS_ENROLLMENT_ENABLED=true
CANOPY_APNS_ENROLLMENT_PER_HOUR=10
CANOPY_APNS_ENROLLMENT_BURST=5

# Whose X-Forwarded-For to believe when identifying the client. Enrollment
# buckets by source address, so the app must see the real caller rather than
# the proxy in front of it. `*` trusts whatever sent the header, which is right
# while the container is reachable only through Coolify's proxy — as `expose`
# (not `ports`) in docker-compose.yml ensures. If you ever publish the port
# directly, narrow this to the proxy's address, or a client can claim any
# address it likes and get a fresh bucket per request.
CANOPY_APNS_FORWARDED_ALLOW_IPS=*

# Bind address and port. Listed for completeness: docker-compose.yml pins both
# rather than reading them from here, because the port is also baked into the
# SERVICE_FQDN_CANOPYAPNS_9247 variable NAME and the two must not drift apart.
# Setting them here only has an effect when running the app outside compose.
CANOPY_APNS_HOST=0.0.0.0
CANOPY_APNS_PORT=9247

# uvicorn log level. Request logs record the instance id, the environment and
# the outcome — never the device token and never the notification text, because
# a log that reconstructs what was forwarded is a store of exactly what this
# service promises not to keep.
CANOPY_APNS_LOG_LEVEL=info
